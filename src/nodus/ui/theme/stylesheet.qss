/* Nodus stylesheet. Words starting with a dollar sign are tokens filled in by
   ThemeManager: colors of the theme (theme.py), the typeface and text roles of the design
   scale (design.py: $title_size, $title_weight…) and "icons", the folder of the icons.
   Text sizes, gaps and corners come only from the design scale, never as numbers
   here, except corners and offsets derived from an element's own size. */

QWidget {
    font-family: $font_family;
    font-size: $body_size;
    color: $text;
}

QMainWindow, #ContentArea, #PageStack {
    background: $background;
}

/* Sidebar */

#Sidebar {
    background: $sidebar;
    border-right: 1px solid $border;
}

#SidebarLogo {
    font-size: $subtitle_size;
    font-weight: $subtitle_weight;
}

#NavButton {
    text-align: left;
    padding: $space_s $space_m;
    border: none;
    border-radius: $radius_l;
    background: transparent;
}

#NavButton[collapsed="true"] {
    text-align: center;
    padding: $space_s;
}

#NavButton:hover {
    background: $hover;
}

#NavButton:checked {
    background: $accent_soft;
    color: $accent;
    font-weight: $strong_weight;
}

#SectionLabel {
    color: $text_muted;
    font-size: $label_size;
    font-weight: $label_weight;
    padding: $space_l $space_s $space_xs $space_s;
}

#SectionToggle {
    color: $text_muted;
    font-size: $label_size;
    font-weight: $label_weight;
    text-align: left;
    padding: $space_l $space_s $space_xs $space_s;
    border: none;
    background: transparent;
}

#SectionToggle:hover {
    color: $text;
}

#SidebarAccounts {
    background: transparent;
}

#SidebarItem {
    padding-left: $space_s;
}

#SidebarFooter {
    color: $text_muted;
    font-size: $label_size;
    padding: $space_s;
}

/* Top bar and pages */

#TopBar {
    background: $background;
    border-bottom: 1px solid $border;
}

#PageTitle {
    font-size: $title_size;
    font-weight: $title_weight;
}

#Card {
    background: $surface;
    border: 1px solid $border;
    border-radius: $radius_xl;
}

#CardTitle, #StatCaption {
    color: $text_muted;
    font-size: $label_size;
    font-weight: $label_weight;
}

#StatValue {
    font-size: $figure_small_size;
    font-weight: $figure_small_weight;
}

#StatValueLarge {
    font-size: $figure_size;
    font-weight: $figure_weight;
}

#StatValueHero {
    font-size: $display_size;
    font-weight: $display_weight;
}

/* Where a dragged row of a ReorderableList would land. */
#DropIndicator {
    background: $accent;
    border-radius: 1px; /* geometry: half its height */
}

#Badge {
    background: $accent_soft;
    color: $accent;
    border-radius: 16px; /* geometry: half its height */
    min-width: $badge;
    max-width: $badge;
    min-height: $badge;
    max-height: $badge;
    font-size: $label_size;
    font-weight: $label_weight;
    qproperty-alignment: AlignCenter;
}

#RowTitle {
    font-weight: $strong_weight;
}

#TileValue {
    font-size: $figure_size;
    font-weight: $figure_weight;
}

/* Small label next to a name, like "sistema" on the "Otros" category */
#Tag {
    background: $accent_soft;
    color: $accent;
    border-radius: $radius_l;
    padding: $space_xxs $space_s;
    font-size: $label_size;
    font-weight: $label_weight;
}

#RowAmount {
    font-size: $strong_size;
    font-weight: $strong_weight;
    padding-right: $space_s;
}

#EmptyState {
    color: $text_muted;
    font-size: $strong_size;
}

/* New version notice under the top bar */

/* Top bar icons and the notifications panel */

QPushButton#IconButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: $radius_l;
}

QPushButton#IconButton:hover {
    background: $hover;
}

/* The arrow back of a detail page, left of its title, as the Back button of Windows. */
QPushButton#BackButton {
    background: transparent;
    border: none;
    border-radius: $radius_l;
}

QPushButton#BackButton:hover {
    background: $hover;
}

QLabel#NotificationCount {
    background: $expense;
    color: #ffffff;
    border-radius: 9px; /* geometry: half its height */
    font-size: $label_size;
    font-weight: $display_weight;
}

QFrame#NotificationPanel,
QFrame#ColorWheelPopup {
    background: $surface;
    border: 1px solid $border;
    border-radius: $radius_xl;
}

QFrame#Separator {
    background: $border;
}

/* Buttons */

QPushButton#PrimaryButton {
    background: $accent;
    color: $on_accent;
    border: none;
    border-radius: $radius_l;
    padding: $space_s $space_l;
    font-weight: $strong_weight;
}

QPushButton#PrimaryButton:hover {
    background: $accent_hover;
}

QPushButton#SecondaryButton, QPushButton#SmallButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: $radius_l;
    padding: $space_s $space_l;
}

QPushButton#SmallButton {
    padding: $space_xs $space_m;
    font-size: $note_size;
}

/* Destructive actions (delete): red text, a red tint under the mouse. */
QPushButton#DangerButton {
    background: $surface;
    color: $expense;
    border: 1px solid $border;
    border-radius: $radius_l;
    padding: $space_s $space_l;
}

QPushButton#DangerButton:hover {
    background: $expense_soft;
    border-color: $expense;
}

QPushButton#SecondaryButton:hover, QPushButton#SmallButton:hover {
    background: $hover;
}

/* The bar that replaces a page's header while several rows are chosen */

QFrame#SelectionBar {
    background: $accent_soft;
    border-radius: $radius_xl;
}

/* The «⋯» that opens a row's actions */

QPushButton#MoreButton {
    background: transparent;
    border: none;
    border-radius: $radius_m;
    padding: 0;
}

QPushButton#MoreButton:hover, QPushButton#MoreButton:pressed {
    background: $hover;
}

/* Where an item is deleted, apart from its everyday actions. */
#DangerZone {
    background: $surface;
    border: 1px solid $expense;
    border-radius: $radius_xl;
}

/* A link in a card's header, such as «Ver todas ›». */
QPushButton#LinkButton {
    background: transparent;
    border: none;
    padding: 0;
    color: $accent;
    font-size: $note_size;
}

QPushButton#LinkButton:hover {
    text-decoration: underline;
}

/* Dialogs and form fields */

QDialog {
    background: $surface;
}

#DialogTitle {
    font-size: $subtitle_size;
    font-weight: $subtitle_weight;
}

QTextBrowser#NewsText {
    background: transparent;
    border: none;
}

#ErrorLabel {
    color: $expense;
}

/* A form's problem, under the field that causes it (dialogs/form_dialog.py), and that
   field's border, until it changes. */
#FieldError {
    color: $expense;
    font-size: $note_size;
}

#FieldHint {
    color: $text_muted;
    font-size: $note_size;
}

#AmountSymbol {
    color: $text_muted;
    font-weight: $strong_weight;
    min-width: $amount_symbol_width;
}

QLineEdit, QComboBox, QDateEdit {
    background: $background;
    border: 1px solid $border;
    border-radius: $radius_m;
    padding: $space_xs $space_s;
    min-height: $field_height;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid $accent;
}

/* After :focus, so a field in error keeps its red border while it is being fixed. */
QLineEdit[error="true"], QComboBox[error="true"], QDateEdit[error="true"],
QLineEdit[error="true"]:focus, QComboBox[error="true"]:focus, QDateEdit[error="true"]:focus {
    border: 1px solid $expense;
}

QLineEdit:disabled, QComboBox:disabled {
    color: $text_muted;
}

QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: $drop_down_width;
}

QComboBox::down-arrow, QDateEdit::down-arrow {
    image: url($icons/chevron-down.svg);
    width: $icon_s;
    height: $icon_s;
}

/* A plain list below the box: Fusion would otherwise open it over the box, aligned to
   the current item, so it could jump up or down. */
QComboBox {
    combobox-popup: 0;
}

/* List filters: an unused one shows its name in gray, an active one gets the accent. */
QComboBox[filter="idle"] {
    color: $text_muted;
}

QComboBox[filter="active"] {
    border: 1px solid $accent;
}

QComboBox[filter] QAbstractItemView#ListPopup {
    color: $text;
}

/* A form's list with nothing chosen yet shows its placeholder in gray, as a text field
   does, so «Elegir categoría» never reads as a category. */
QComboBox[empty="true"] {
    color: $text_muted;
}

QComboBox[empty="true"] QAbstractItemView#ListPopup {
    color: $text;
}

/* Every list that opens over a page (a combo box's, the suggestions under a field) is a
   ListPopup (widgets/combo_box.py), spaced by the Popup steps of design.py like the
   menus, so the first and last options never touch the frame. */
QAbstractItemView#ListPopup {
    background: $surface;
    border: 1px solid $border;
    padding: $popup_padding;
    outline: none;
    selection-background-color: $accent_soft;
    selection-color: $accent;
}

QAbstractItemView#ListPopup::item {
    padding: $list_item_padding;
    border-radius: $popup_item_radius;
}

QAbstractItemView#ListPopup::item:selected,
QAbstractItemView#ListPopup::item:hover {
    background: $accent_soft;
    color: $accent;
}

/* Check boxes: a box with the theme border, filled with the accent when checked. */

QCheckBox {
    spacing: $space_s;
}

QCheckBox:disabled {
    color: $text_muted;
}

QCheckBox::indicator {
    width: $icon_m;
    height: $icon_m;
    border: 1px solid $text_muted;
    border-radius: $radius_s;
    background: $background;
}

QCheckBox::indicator:hover {
    border: 1px solid $accent;
}

QCheckBox::indicator:checked {
    border: 1px solid $accent;
    background: $accent;
    image: url($icons/check.svg);
}

QCheckBox::indicator:disabled {
    border: 1px solid $border;
}

/* Progress bar (downloading an update) */

QProgressBar {
    border: none;
    border-radius: $radius_s;
    background: $hover;
    max-height: $progress_height;
}

QProgressBar::chunk {
    border-radius: $radius_s;
    background: $accent;
}

/* Segmented control (e.g. Gasto / Ingreso / Transferencia) */

#SegmentedControl {
    background: $background;
    border: 1px solid $border;
    border-radius: $radius_l;
}

QPushButton#Segment {
    background: transparent;
    border: none;
    border-radius: $radius_m;
    padding: $space_xs $space_l;
    color: $text_muted;
}

QPushButton#Segment:hover {
    color: $text;
}

QPushButton#Segment:checked {
    background: $surface;
    color: $accent;
    font-weight: $strong_weight;
}

QPushButton#Segment:disabled {
    color: $border;
}

/* Tabs that switch between the views of a page (Page.set_tabs): underlined, in the
   accent color when chosen, as the sidebar's current page. */

QFrame#TabBar {
    background: transparent;
    border: none;
    border-bottom: 1px solid $border;
}

QPushButton#Tab {
    background: transparent;
    border: none;
    border-bottom: $line_thick solid transparent;
    border-radius: 0;
    padding: $space_s $space_xxs;
    color: $text_muted;
}

QPushButton#Tab:hover {
    color: $text;
}

QPushButton#Tab:checked {
    color: $accent;
    font-weight: $strong_weight;
    border-bottom: $line_thick solid $accent;
}

/* Period selector: "‹ Noviembre 2026 ▾ ›" */

QPushButton#PeriodButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: $radius_l;
    padding: $space_xs $space_xxl $space_xs $space_m;
    font-weight: $strong_weight;
    min-width: $period_button_min_width;
}

QPushButton#PeriodButton:hover {
    background: $hover;
    border-color: $border;
}

QPushButton#PeriodButton::menu-indicator {
    image: url($icons/chevron-down.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px; /* geometry: the arrow centered in the right padding */
    width: $icon_s;
    height: $icon_s;
}

QMenu {
    background: $surface;
    border: 1px solid $border;
    border-radius: $popup_radius;
    padding: $popup_padding;
}

QMenu::item {
    padding: $menu_item_padding;
    padding-right: $space_xxl;  /* room after the longest action */
    border-radius: $popup_item_radius;
}

QMenu::item:selected {
    background: $accent_soft;
    color: $accent;
}

QMenu::item:disabled {
    color: $text_muted;
    background: transparent;
}

QMenu::icon {
    padding-left: $space_s;
}

QMenu::separator {
    height: $line_thin;
    background: $border;
    margin: $popup_divider_margin;
}

/* Tables */

QTableView {
    background: $surface;
    border: none;
    selection-background-color: $accent_soft;
    selection-color: $text;
    outline: none;
}

QTableView::item {
    padding: 0 $space_s;
    border-bottom: 1px solid $border;
}

QHeaderView::section {
    background: $surface;
    color: $text_muted;
    border: none;
    border-bottom: 1px solid $border;
    padding: $space_s;
    font-size: $label_size;
    font-weight: $label_weight;
}

/* Room for the sort arrow, which Qt draws at the right edge of the section. */
#SortableTable QHeaderView::section {
    padding-right: $space_xl;
}

QCalendarWidget QWidget {
    background: $surface;
    alternate-background-color: $background;
}

/* The calendar grid is a table too: without this it inherits the table padding and
   two-digit days no longer fit ("..."). */
QCalendarWidget QTableView::item {
    padding: 0;
    border: none;
}

/* A date field's calendar opens over the page like a list (widgets/date_input.py): the
   same frame, and the chosen day in the colors of a list's chosen option. */
QCalendarWidget {
    border: 1px solid $border;
}

QCalendarWidget QTableView {
    outline: none;
    selection-background-color: $accent_soft;
    selection-color: $accent;
}

QCalendarWidget QToolButton {
    background: transparent;
    border: none;
    border-radius: $radius_m;
    padding: $space_xs $space_s;
    font-weight: $strong_weight;
}

QCalendarWidget QToolButton:hover {
    background: $hover;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url($icons/chevron-left.svg);
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url($icons/chevron-right.svg);
}

QCalendarWidget QToolButton#qt_calendar_monthbutton {
    padding-right: $space_xxl;
}

QCalendarWidget QToolButton::menu-indicator {
    image: url($icons/chevron-down.svg);
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: $space_xs;
    width: $icon_xs;
    height: $icon_xs;
}

/* Amounts: MoneyLabel sets the "tone" property */

QLabel[tone="positive"] {
    color: $income;
}

QLabel[tone="negative"] {
    color: $expense;
}

QLabel[muted="true"] {
    color: $text_muted;
}

/* Scrollbars */

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: $scroll_bar_width;
    margin: $space_xxs;
}

QScrollBar::handle:vertical {
    background: $border;
    border-radius: 3px; /* geometry: half its width */
    min-height: $scroll_handle_min_length;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QToolTip {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    padding: $space_xs;
}

/* Relative change pill (ChangeBadge) */

QLabel#ChangeBadge {
    border-radius: 9px; /* geometry: half its height */
    padding: $space_xxs $space_s;
    font-size: $note_size;
    font-weight: $strong_weight;
    background: $hover;
    color: $text_muted;
}

/* Nothing to compare with: a plain "—", not a pill. */
QLabel#ChangeBadge[tone="empty"] {
    background: transparent;
    padding: $space_xxs 0;
}

QLabel#ChangeBadge[tone="good"] {
    background: $income_soft;
    color: $income;
}

QLabel#ChangeBadge[tone="bad"] {
    background: $expense_soft;
    color: $expense;
}

QLabel#ChangeBadge[tone="warning"] {
    background: $warning_soft;
    color: $warning;
}

QLabel#ChangeBadge[tone="neutral"] {
    background: $hover;
    color: $text_muted;
}

/* The «✓» that pays a charge from its row (PayButton), as the «⋯» beside it in size. */
QPushButton#PayButton {
    background: $income_soft;
    border: 1px solid transparent;
    border-radius: $radius_m;
}

QPushButton#PayButton:hover {
    border-color: $income;
}

/* Rows that light up under the mouse, as the sidebar's items: list rows that open
   something or have a menu (make_hoverable), and the Dashboard's category rows, which
   also light up with their slice of the donut. */

[hoverable="true"], QFrame#CategoryLine {
    border-radius: $radius_m;
}

[hoverable="true"]:hover, QFrame#CategoryLine[highlighted="true"] {
    background: $hover;
}

/* Boxed figures */

QFrame#FigureTile {
    border: 1px solid $border;
    border-radius: $radius_l;
}

/* Tag chips (TagInput, tags column) */

QToolButton#TagChip {
    border: 1px solid $border;
    border-radius: 10px; /* geometry: half its height */
    padding: $space_xxs $space_s;
    background: $hover;
    color: $text;
    font-size: $note_size;
}

QToolButton#TagChip:hover {
    border: 1px solid $expense;
}

QSlider::groove:horizontal {
    height: $slider_groove;
    background: $border;
    border-radius: 3px; /* geometry: half its height */
}

QSlider::handle:horizontal {
    width: $slider_handle;
    margin: -5px 0; /* geometry: centers the handle on the groove */
    background: $accent;
    border-radius: 8px; /* geometry: half its height */
}
