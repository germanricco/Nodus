/* Nodus stylesheet. Words starting with a dollar sign are theme tokens (see theme.py),
   filled in by ThemeManager. */

QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
    color: $text;
}

QMainWindow, #ContentArea, #PageStack {
    background: $background;
}

/* Sidebar */

#Sidebar {
    background: $sidebar;
    border-right: 1px solid $border;
}

#SidebarLogo {
    font-size: 16pt;
    font-weight: 600;
    padding: 4px 8px 12px 8px;
}

#NavButton {
    text-align: left;
    padding: 8px 12px;
    border: none;
    border-radius: 8px;
    background: transparent;
}

#NavButton:hover {
    background: $hover;
}

#NavButton:checked {
    background: $accent_soft;
    color: $accent;
    font-weight: 600;
}

#SectionLabel {
    color: $text_muted;
    font-size: 8pt;
    font-weight: 600;
    padding: 16px 8px 4px 8px;
}

#SidebarAccounts {
    background: transparent;
}

#SidebarItem {
    padding-left: 8px;
}

#SidebarFooter {
    color: $text_muted;
    font-size: 8pt;
    padding: 8px;
}

/* Top bar and pages */

#TopBar {
    background: $background;
    border-bottom: 1px solid $border;
}

#PageTitle {
    font-size: 20pt;
    font-weight: 600;
}

#Card {
    background: $surface;
    border: 1px solid $border;
    border-radius: 12px;
}

#CardTitle, #StatCaption {
    color: $text_muted;
    font-size: 8pt;
    font-weight: 600;
}

#StatValue {
    font-size: 13pt;
    font-weight: 600;
}

#StatValueLarge {
    font-size: 20pt;
    font-weight: 600;
}

#Badge {
    background: $accent_soft;
    color: $accent;
    border-radius: 16px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 8pt;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
}

#RowTitle {
    font-weight: 600;
}

#RowAmount {
    font-size: 11pt;
    font-weight: 600;
    padding-right: 8px;
}

#EmptyState {
    color: $text_muted;
    font-size: 11pt;
}

/* Buttons */

QPushButton#PrimaryButton {
    background: $accent;
    color: $on_accent;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: $accent_hover;
}

QPushButton#SecondaryButton, QPushButton#SmallButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 8px 16px;
}

QPushButton#SmallButton {
    padding: 4px 10px;
    font-size: 9pt;
}

QPushButton#SecondaryButton:hover, QPushButton#SmallButton:hover {
    background: $hover;
}

/* Dialogs and form fields */

QDialog {
    background: $surface;
}

#DialogTitle {
    font-size: 15pt;
    font-weight: 600;
}

#ErrorLabel {
    color: $expense;
}

#FieldHint {
    color: $text_muted;
    font-size: 9pt;
}

#AmountSymbol {
    color: $text_muted;
    font-weight: 600;
    min-width: 28px;
}

QLineEdit, QComboBox, QDateEdit {
    background: $background;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 6px 8px;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid $accent;
}

QLineEdit:disabled, QComboBox:disabled {
    color: $text_muted;
}

QComboBox QAbstractItemView {
    background: $surface;
    border: 1px solid $border;
    selection-background-color: $accent_soft;
    selection-color: $text;
}

/* Amounts: MoneyLabel sets the "tone" property */

QLabel[tone="positive"] {
    color: $income;
}

QLabel[tone="negative"] {
    color: $expense;
}

QLabel[muted="true"] {
    color: $text_muted;
}

/* Scrollbars */

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: $border;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QToolTip {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    padding: 4px;
}
