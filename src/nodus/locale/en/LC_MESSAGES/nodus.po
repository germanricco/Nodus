msgstr "That refund doesn't exceed what's left of the expense."

#: nodus/services/transactions/transaction_service.py
msgid "Las transferencias se editan como transferencia."
msgstr "Transfers are edited as transfers."

#: nodus/services/transactions/transaction_service.py
msgid "Las cuotas se editan desde su compra."
msgstr "Installments are edited from their purchase."

#: nodus/services/transactions/transaction_service.py
#, python-brace-format
msgid "La categoría «{category}» no corresponde a este tipo de transacción."
msgstr "The category “{category}” doesn't fit this type of transaction."

#: nodus/services/transactions/transaction_service.py
msgid "Un reembolso tiene que devolver un gasto."
msgstr "A refund has to pay back an expense."

#: nodus/services/transactions/transaction_service.py
#, python-brace-format
msgid "El reembolso supera lo que queda por reembolsar de ese gasto: {remaining}."
msgstr "The refund exceeds what's left to refund of that expense: {remaining}."

#: nodus/services/transactions/transaction_service.py
#, python-brace-format
msgid "Ya se reembolsaron {refunded} de este gasto: el monto no puede ser menor."
msgstr "{refunded} of this expense was already refunded: the amount can't be lower."

#: nodus/services/transactions/transfer_service.py
msgid "La transferencia no existe."
msgstr "The transfer doesn't exist."

#: nodus/services/transactions/transfer_service.py
msgid "La cuenta de origen y la de destino deben ser distintas."
msgstr "The source and destination accounts must be different."

#: nodus/services/transactions/transfer_service.py
msgid "Entre cuentas de la misma moneda, el monto que sale y el que entra deben ser iguales."
msgstr ""
"Between accounts in the same currency, the amount that leaves and the amount that arrives must be"
" equal."

#: nodus/services/transactions/transfer_service.py
msgid "Indica el monto que entra en la cuenta de destino."
msgstr "Enter the amount that arrives in the destination account."

